<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Security Groups -->
        <record id="group_joplin_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <!-- Auto-assign joplin access to all internal users -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_joplin_user'))]"/>
        </record>

        <record id="group_joplin_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_joplin_user'))]"/>
        </record>

        <!-- Record Rules -->

        <!-- joplin.note: owner sees own notes, followers see shared notes, admins see all -->
        <record id="rule_joplin_note_personal" model="ir.rule">
            <field name="name">joplin.note: own notes + followers</field>
            <field name="model_id" ref="model_joplin_note"/>
            <field name="groups" eval="[(4, ref('group_joplin_user'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('message_follower_ids.partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_note_admin" model="ir.rule">
            <field name="name">joplin.note: admin full access</field>
            <field name="model_id" ref="model_joplin_note"/>
            <field name="groups" eval="[(4, ref('group_joplin_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- joplin.folder: owner sees own folders -->
        <record id="rule_joplin_folder_personal" model="ir.rule">
            <field name="name">joplin.folder: own folders</field>
            <field name="model_id" ref="model_joplin_folder"/>
            <field name="groups" eval="[(4, ref('group_joplin_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_folder_admin" model="ir.rule">
            <field name="name">joplin.folder: admin full access</field>
            <field name="model_id" ref="model_joplin_folder"/>
            <field name="groups" eval="[(4, ref('group_joplin_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- joplin.tag: owner sees own tags -->
        <record id="rule_joplin_tag_personal" model="ir.rule">
            <field name="name">joplin.tag: own tags</field>
            <field name="model_id" ref="model_joplin_tag"/>
            <field name="groups" eval="[(4, ref('group_joplin_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_tag_admin" model="ir.rule">
            <field name="name">joplin.tag: admin full access</field>
            <field name="model_id" ref="model_joplin_tag"/>
            <field name="groups" eval="[(4, ref('group_joplin_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- joplin.resource: owner sees own resources -->
        <record id="rule_joplin_resource_personal" model="ir.rule">
            <field name="name">joplin.resource: own + note followers</field>
            <field name="model_id" ref="model_joplin_resource"/>
            <field name="groups" eval="[(4, ref('group_joplin_user'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('note_id.message_follower_ids.partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_resource_admin" model="ir.rule">
            <field name="name">joplin.resource: admin full access</field>
            <field name="model_id" ref="model_joplin_resource"/>
            <field name="groups" eval="[(4, ref('group_joplin_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- joplin.revision: same access as notes -->
        <record id="rule_joplin_revision_personal" model="ir.rule">
            <field name="name">joplin.revision: own notes + followers</field>
            <field name="model_id" ref="model_joplin_revision"/>
            <field name="groups" eval="[(4, ref('group_joplin_user'))]"/>
            <field name="domain_force">['|', ('note_id.user_id', '=', user.id), ('note_id.message_follower_ids.partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_revision_admin" model="ir.rule">
            <field name="name">joplin.revision: admin full access</field>
            <field name="model_id" ref="model_joplin_revision"/>
            <field name="groups" eval="[(4, ref('group_joplin_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- joplin.api.token: each user sees own tokens -->
        <record id="rule_joplin_api_token_personal" model="ir.rule">
            <field name="name">joplin.api.token: own tokens</field>
            <field name="model_id" ref="model_joplin_api_token"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
