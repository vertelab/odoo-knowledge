<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="group_graph_user" model="res.groups">
            <field name="name">User: Graph Sync</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="group_graph_admin" model="res.groups">
            <field name="name">Administrator: Graph Sync</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_graph_user'))]"/>
        </record>

        <!-- Auto-assign user access to all internal users -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_graph_user'))]"/>
        </record>

        <!-- Record rule: User sees only their own configs -->
        <record id="rule_graph_model_user" model="ir.rule">
            <field name="name">knowledge.graph.model: own only</field>
            <field name="model_id" ref="model_knowledge_graph_model"/>
            <field name="groups" eval="[(4, ref('group_graph_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>
