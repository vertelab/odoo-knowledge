<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Default system parameters for RabbitMQ connection -->
        <record id="knowledge_graphdb_rabbitmq_host" model="ir.config_parameter">
            <field name="key">knowledge_graphdb.rabbitmq_host</field>
            <field name="value">localhost</field>
        </record>

        <record id="knowledge_graphdb_rabbitmq_port" model="ir.config_parameter">
            <field name="key">knowledge_graphdb.rabbitmq_port</field>
            <field name="value">5672</field>
        </record>

        <record id="knowledge_graphdb_rabbitmq_user" model="ir.config_parameter">
            <field name="key">knowledge_graphdb.rabbitmq_user</field>
            <field name="value">guest</field>
        </record>

        <record id="knowledge_graphdb_rabbitmq_exchange" model="ir.config_parameter">
            <field name="key">knowledge_graphdb.rabbitmq_exchange</field>
            <field name="value">odoo_events_topic</field>
        </record>

        <record id="knowledge_graphdb_rabbitmq_exchange_type" model="ir.config_parameter">
            <field name="key">knowledge_graphdb.rabbitmq_exchange_type</field>
            <field name="value">topic</field>
        </record>

        <record id="knowledge_graphdb_rabbitmq_vhost" model="ir.config_parameter">
            <field name="key">knowledge_graphdb.rabbitmq_vhost</field>
            <field name="value">/</field>
        </record>

    </data>
</odoo>
