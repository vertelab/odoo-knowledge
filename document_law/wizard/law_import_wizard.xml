<odoo>
  <data>
    <record id="view_law_import_wizard_form" model="ir.ui.view">
      <field name="name">document.law.import.wizard.form</field>
      <field name="model">document.law.import.wizard</field>
      <field name="arch" type="xml">
        <form string="Import laws from Riksdagen">
          <group>
            <field name="mode" widget="radio"/>
          </group>
          <group invisible="mode != 'designation'">
            <field name="beteckningar"
                   placeholder="2006:804&#10;2010:1622&#10;1993:1617"
                   required="mode == 'designation'"/>
            <field name="refresh"/>
          </group>
          <group invisible="mode != 'backfill'">
            <field name="max_pages"/>
          </group>
          <group invisible="not result">
            <field name="result" nolabel="1" colspan="2"/>
          </group>
          <footer>
            <button name="action_run" type="object" string="Run"
                    class="btn-primary"/>
            <button string="Close" special="cancel" class="btn-secondary"/>
          </footer>
        </form>
      </field>
    </record>

    <record id="action_law_import_wizard" model="ir.actions.act_window">
      <field name="name">Import laws</field>
      <field name="res_model">document.law.import.wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
    </record>

    <menuitem id="menu_law_import_wizard"
              name="Import laws"
              parent="menu_document_law"
              action="action_law_import_wizard"
              sequence="10"/>
  </data>
</odoo>
