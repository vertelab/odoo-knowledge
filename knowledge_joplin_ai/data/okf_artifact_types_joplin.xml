<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Artifact type for the joplin bridge (okf-mixin D12).

             `bridge_module` points at knowledge_joplin_ai, so the
             taxonomy can be traced back to ONE bridge. -->
        <record id="artifact_type_joplin_note" model="ai.artifact.type">
            <field name="name">joplin_note</field>
            <field name="kind">knowledge</field>
            <field name="bridge_module">knowledge_joplin_ai</field>
            <field name="model_id" ref="knowledge_joplin.model_joplin_note"/>
            <field name="okf_contract" eval="{'generated_by': 'process', 'stale_policy': 'source', 'stale_ttl_days': 0, 'retention_purpose': 'none', 'retention_days': 0}"/>
        </record>
    </data>
</odoo>
