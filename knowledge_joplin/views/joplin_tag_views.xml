<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Kanban View -->
        <record id="view_joplin_tag_kanban" model="ir.ui.view">
            <field name="name">joplin.tag.kanban</field>
            <field name="model">joplin.tag</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="note_count"/>
                    <field name="color"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_card_header">
                                    <div class="o_kanban_card_title">
                                        <i class="fa fa-tag" title="Tag"/> <field name="name"/>
                                    </div>
                                </div>
                                <div class="oe_kanban_content">
                                    <field name="note_count"/> notes
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_joplin_tag_form" model="ir.ui.view">
            <field name="name">joplin.tag.form</field>
            <field name="model">joplin.tag</field>
            <field name="arch" type="xml">
                <form string="Tag">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Tag name..."/>
                            </h1>
                        </div>
                        <group>
                            <field name="note_count"/>
                            <field name="user_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_joplin_tag" model="ir.actions.act_window">
            <field name="name">Tags</field>
            <field name="res_model">joplin.tag</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{}</field>
        </record>

    </data>
</odoo>
