<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View -->
        <record id="view_joplin_resource_tree" model="ir.ui.view">
            <field name="name">joplin.resource.tree</field>
            <field name="model">joplin.resource</field>
            <field name="arch" type="xml">
                <list string="Resources">
                    <field name="name"/>
                    <field name="mime"/>
                    <field name="filename"/>
                    <field name="file_size"/>
                    <field name="note_id"/>
                    <field name="created_time"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_joplin_resource_form" model="ir.ui.view">
            <field name="name">joplin.resource.form</field>
            <field name="model">joplin.resource</field>
            <field name="arch" type="xml">
                <form string="Resource">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="mime"/>
                                <field name="filename"/>
                                <field name="file_extension"/>
                                <field name="file_size"/>
                            </group>
                            <group>
                                <field name="note_id"/>
                                <field name="user_id"/>
                                <field name="created_time"/>
                            </group>
                        </group>
                        <field name="datas" filename="filename"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_joplin_resource" model="ir.actions.act_window">
            <field name="name">Resources</field>
            <field name="res_model">joplin.resource</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
