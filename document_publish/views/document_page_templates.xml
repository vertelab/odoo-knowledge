<odoo>
  <data>

    <template id="page_not_found" name="Page Not Found">
      <t t-call="website.layout">
        <div class="container">
          <h1>Page Not Found</h1>
          <p>Sorry, the requested page could not be found.</p>
        </div>
      </t>
    </template>

    <template id="manual_page" name="Custom Content">
      <t t-call="website.layout">
        <div class="container mt-5">
          <h2>
            <t t-esc="name"/>
          </h2>
          <div class="mb-3">
            <strong>Content:</strong>
            <p>
              <t t-esc="content"/>
            </p>
          </div>
          <div class="mb-3">
            <strong>Draft Name:</strong>
            <span>
              <t t-esc="draft_name"/>
            </span>
          </div>
          <div class="mb-3">
            <strong>Draft Summary:</strong>
            <span>
              <t t-esc="draft_summery"/>
            </span>
          </div>
          <div class="mb-3">
            <strong>Content UID:</strong>
            <span>
              <t t-esc="content_uid"/>
            </span>
          </div>
          <div class="mb-3">
            <strong>Content Date:</strong>
            <span>
              <t t-esc="content_date"/>
            </span>
          </div>
        </div>
      </t>
    </template>

  </data>
</odoo>