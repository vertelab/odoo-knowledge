<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Demo Users -->
        <record id="demo_user_joplin_1" model="res.users">
            <field name="name">Joplin Demo User 1</field>
            <field name="login">joplin_demo1@example.com</field>
            <field name="email">joplin_demo1@example.com</field>
            <field name="groups_id" eval="[(4, ref('knowledge_joplin.group_joplin_user'))]"/>
        </record>

        <record id="demo_user_joplin_2" model="res.users">
            <field name="name">Joplin Demo User 2</field>
            <field name="login">joplin_demo2@example.com</field>
            <field name="email">joplin_demo2@example.com</field>
            <field name="groups_id" eval="[(4, ref('knowledge_joplin.group_joplin_user'))]"/>
        </record>

        <!-- Demo Folders (User 1) -->
        <record id="demo_folder_personal" model="joplin.folder">
            <field name="joplin_id">a000000000000001a000000000000001</field>
            <field name="name">Personal</field>
            <field name="user_id" ref="demo_user_joplin_1"/>
        </record>

        <record id="demo_folder_work" model="joplin.folder">
            <field name="joplin_id">a000000000000002a000000000000002</field>
            <field name="name">Work</field>
            <field name="user_id" ref="demo_user_joplin_1"/>
        </record>

        <record id="demo_folder_projects" model="joplin.folder">
            <field name="joplin_id">a000000000000003a000000000000003</field>
            <field name="name">Projects</field>
            <field name="parent_id" ref="demo_folder_work"/>
            <field name="user_id" ref="demo_user_joplin_1"/>
        </record>

        <record id="demo_folder_archive" model="joplin.folder">
            <field name="joplin_id">a000000000000004a000000000000004</field>
            <field name="name">Archive</field>
            <field name="user_id" ref="demo_user_joplin_1"/>
        </record>

        <!-- Demo Tags -->
        <record id="demo_tag_important" model="joplin.tag">
            <field name="joplin_id">b000000000000001b000000000000001</field>
            <field name="name">important</field>
            <field name="user_id" ref="demo_user_joplin_1"/>
        </record>

        <record id="demo_tag_todo" model="joplin.tag">
            <field name="joplin_id">b000000000000002b000000000000002</field>
            <field name="name">todo</field>
            <field name="user_id" ref="demo_user_joplin_1"/>
        </record>

        <record id="demo_tag_idea" model="joplin.tag">
            <field name="joplin_id">b000000000000003b000000000000003</field>
            <field name="name">idea</field>
            <field name="user_id" ref="demo_user_joplin_1"/>
        </record>

        <record id="demo_tag_work" model="joplin.tag">
            <field name="joplin_id">b000000000000004b000000000000004</field>
            <field name="name">work</field>
            <field name="user_id" ref="demo_user_joplin_1"/>
        </record>

        <record id="demo_tag_personal" model="joplin.tag">
            <field name="joplin_id">b000000000000005b000000000000005</field>
            <field name="name">personal</field>
            <field name="user_id" ref="demo_user_joplin_1"/>
        </record>

        <!-- Demo Notes (User 1) -->
        <record id="demo_note_welcome" model="joplin.note">
            <field name="joplin_id">c000000000000001c000000000000001</field>
            <field name="title">Welcome to Joplin Notes</field>
            <field name="body"># Welcome to Joplin Notes

This is a **demo note** showing Markdown support.

## Features

- Markdown rendering with code blocks
- Tag support
- Folder organization
- Version history via revisions

### Code Example

```python
def hello():
    print("Hello from Joplin!")
```

| Feature | Status |
|---------|--------|
| Markdown | ✅ |
| Tags | ✅ |
| Revisions | ✅ |

> Note: This is rendered from Markdown to HTML automatically.
</field>
            <field name="folder_id" ref="demo_folder_personal"/>
            <field name="user_id" ref="demo_user_joplin_1"/>
            <field name="markup_language">1</field>
        </record>

        <record id="demo_note_todo" model="joplin.note">
            <field name="joplin_id">c000000000000002c000000000000002</field>
            <field name="title">Complete project documentation</field>
            <field name="body">## Tasks

- [ ] Write API documentation
- [ ] Add Swagger/OpenAPI specs
- [ ] Review with team
- [x] Set up demo environment

Deadline: End of sprint
</field>
            <field name="folder_id" ref="demo_folder_projects"/>
            <field name="user_id" ref="demo_user_joplin_1"/>
            <field name="is_todo">True</field>
            <field name="tag_ids" eval="[(4, ref('demo_tag_todo')), (4, ref('demo_tag_work'))]"/>
        </record>

        <record id="demo_note_meeting" model="joplin.note">
            <field name="joplin_id">c000000000000003c000000000000003</field>
            <field name="title">Meeting Notes - Sprint Planning</field>
            <field name="body">## Sprint Planning - Week 42

**Attendees:** Team Alpha, Product Owner, Scrum Master

### Agenda

1. Review previous sprint
2. Plan upcoming work
3. Assign tasks

### Action Items

- [ ] Set up CI/CD pipeline
- [ ] Migrate database schema
- [ ] Update dependencies

### Notes

The team agreed to focus on **performance improvements**
this sprint. Estimated velocity: 35 story points.
</field>
            <field name="folder_id" ref="demo_folder_work"/>
            <field name="user_id" ref="demo_user_joplin_1"/>
            <field name="tag_ids" eval="[(4, ref('demo_tag_work'))]"/>
            <field name="author">Demo User 1</field>
        </record>

        <record id="demo_note_resource_test" model="joplin.note">
            <field name="joplin_id">c000000000000004c000000000000004</field>
            <field name="title">Attachment Test Note</field>
            <field name="body">This note is used to test resource attachments.

Check the Resources tab for attached files.
</field>
            <field name="folder_id" ref="demo_folder_personal"/>
            <field name="user_id" ref="demo_user_joplin_1"/>
            <field name="tag_ids" eval="[(4, ref('demo_tag_important'))]"/>
        </record>

        <!-- Demo Notes (User 2) -->
        <record id="demo_note_user2_first" model="joplin.note">
            <field name="joplin_id">c000000000000005c000000000000005</field>
            <field name="title">User 2 - Personal Note</field>
            <field name="body">This note belongs to Demo User 2.

It should only be visible to User 2 and admins.
</field>
            <field name="user_id" ref="demo_user_joplin_2"/>
        </record>

        <record id="demo_note_user2_shared" model="joplin.note">
            <field name="joplin_id">c000000000000006c000000000000006</field>
            <field name="title">Shared Note - Followers Can See</field>
            <field name="body">This note is owned by User 2 but shared with followers.

When User 1 follows this note, they gain access.
</field>
            <field name="user_id" ref="demo_user_joplin_2"/>
            <field name="tag_ids" eval="[(4, ref('demo_tag_important'))]"/>
        </record>

        <!-- Note-Tag Relations -->
        <record id="demo_note_tag_welcome_important" model="joplin.note.tag">
            <field name="note_id" ref="demo_note_welcome"/>
            <field name="tag_id" ref="demo_tag_important"/>
        </record>
        <record id="demo_note_tag_welcome_personal" model="joplin.note.tag">
            <field name="note_id" ref="demo_note_welcome"/>
            <field name="tag_id" ref="demo_tag_personal"/>
        </record>
        <record id="demo_note_tag_meeting_work" model="joplin.note.tag">
            <field name="note_id" ref="demo_note_meeting"/>
            <field name="tag_id" ref="demo_tag_work"/>
        </record>
        <record id="demo_note_tag_resource_important" model="joplin.note.tag">
            <field name="note_id" ref="demo_note_resource_test"/>
            <field name="tag_id" ref="demo_tag_important"/>
        </record>

        <!-- Demo Resources -->
        <record id="demo_resource_text" model="joplin.resource">
            <field name="joplin_id">d000000000000001d000000000000001</field>
            <field name="name">Sample Text File</field>
            <field name="mime">text/plain</field>
            <field name="filename">sample.txt</field>
            <field name="file_extension">txt</field>
            <field name="note_id" ref="demo_note_resource_test"/>
            <field name="user_id" ref="demo_user_joplin_1"/>
        </record>

        <!-- Demo API Token -->
        <record id="demo_api_token" model="joplin.api.token">
            <field name="token">0123456789abcdef0123456789abcdef</field>
            <field name="user_id" ref="demo_user_joplin_1"/>
            <field name="name">Demo API Token</field>
        </record>

    </data>
</odoo>
