<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Permission levels (3 groups):
              - User: Only Own Document   — sees own notes + followed notes
              - User: All Document        — sees all notes
              - Administrator             — full access
            Follower access is built into the "Only Own" rule via followers.
        -->

        <!-- ================================================================ -->
        <!-- SECURITY GROUPS                                                    -->
        <!-- ================================================================ -->

        <record id="group_joplin_user_own" model="res.groups">
            <field name="name">User: Only Own Document</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="group_joplin_user_all" model="res.groups">
            <field name="name">User: All Document</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_joplin_user_own'))]"/>
        </record>

        <record id="group_joplin_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_joplin_user_all'))]"/>
        </record>

        <!-- Auto-assign own+follower access to all internal users -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_joplin_user_own'))]"/>
        </record>

        <!-- Auto-assign Administrator to all system users (admin etc.) -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_joplin_admin'))]"/>
        </record>

        <!-- ================================================================ -->
        <!-- RECORD RULES                                                       -->
        <!-- ================================================================ -->

        <!-- ── joplin.note ── -->

        <record id="rule_joplin_note_own" model="ir.rule">
            <field name="name">joplin.note: own + follower</field>
            <field name="model_id" ref="model_joplin_note"/>
            <field name="groups" eval="[(4, ref('group_joplin_user_own'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('message_follower_ids.partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_note_all" model="ir.rule">
            <field name="name">joplin.note: all documents</field>
            <field name="model_id" ref="model_joplin_note"/>
            <field name="groups" eval="[(4, ref('group_joplin_user_all'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_note_admin" model="ir.rule">
            <field name="name">joplin.note: administrator</field>
            <field name="model_id" ref="model_joplin_note"/>
            <field name="groups" eval="[(4, ref('group_joplin_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- ── joplin.folder ── -->

        <record id="rule_joplin_folder_own" model="ir.rule">
            <field name="name">joplin.folder: own</field>
            <field name="model_id" ref="model_joplin_folder"/>
            <field name="groups" eval="[(4, ref('group_joplin_user_own'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_folder_all" model="ir.rule">
            <field name="name">joplin.folder: all</field>
            <field name="model_id" ref="model_joplin_folder"/>
            <field name="groups" eval="[(4, ref('group_joplin_user_all'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_folder_admin" model="ir.rule">
            <field name="name">joplin.folder: administrator</field>
            <field name="model_id" ref="model_joplin_folder"/>
            <field name="groups" eval="[(4, ref('group_joplin_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- ── joplin.tag ── -->

        <record id="rule_joplin_tag_own" model="ir.rule">
            <field name="name">joplin.tag: own</field>
            <field name="model_id" ref="model_joplin_tag"/>
            <field name="groups" eval="[(4, ref('group_joplin_user_own'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_tag_all" model="ir.rule">
            <field name="name">joplin.tag: all</field>
            <field name="model_id" ref="model_joplin_tag"/>
            <field name="groups" eval="[(4, ref('group_joplin_user_all'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_tag_admin" model="ir.rule">
            <field name="name">joplin.tag: administrator</field>
            <field name="model_id" ref="model_joplin_tag"/>
            <field name="groups" eval="[(4, ref('group_joplin_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- ── joplin.resource ── -->

        <record id="rule_joplin_resource_own" model="ir.rule">
            <field name="name">joplin.resource: own + note follower</field>
            <field name="model_id" ref="model_joplin_resource"/>
            <field name="groups" eval="[(4, ref('group_joplin_user_own'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('note_id.message_follower_ids.partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_resource_all" model="ir.rule">
            <field name="name">joplin.resource: all</field>
            <field name="model_id" ref="model_joplin_resource"/>
            <field name="groups" eval="[(4, ref('group_joplin_user_all'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_resource_admin" model="ir.rule">
            <field name="name">joplin.resource: administrator</field>
            <field name="model_id" ref="model_joplin_resource"/>
            <field name="groups" eval="[(4, ref('group_joplin_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- ── joplin.revision ── -->

        <record id="rule_joplin_revision_own" model="ir.rule">
            <field name="name">joplin.revision: own + follower + owner</field>
            <field name="model_id" ref="model_joplin_revision"/>
            <field name="groups" eval="[(4, ref('group_joplin_user_own'))]"/>
            <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('note_id.user_id', '=', user.id), ('note_id.message_follower_ids.partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_revision_all" model="ir.rule">
            <field name="name">joplin.revision: all</field>
            <field name="model_id" ref="model_joplin_revision"/>
            <field name="groups" eval="[(4, ref('group_joplin_user_all'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_joplin_revision_admin" model="ir.rule">
            <field name="name">joplin.revision: administrator</field>
            <field name="model_id" ref="model_joplin_revision"/>
            <field name="groups" eval="[(4, ref('group_joplin_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- ── joplin.api.token ── -->

        <record id="rule_joplin_api_token_own" model="ir.rule">
            <field name="name">joplin.api.token: own tokens</field>
            <field name="model_id" ref="model_joplin_api_token"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>
