<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Search View -->
        <record id="view_joplin_folder_search" model="ir.ui.view">
            <field name="name">joplin.folder.search</field>
            <field name="model">joplin.folder</field>
            <field name="arch" type="xml">
                <search string="Search Folders">
                    <field name="name"/>
                    <field name="user_id"/>
                </search>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_joplin_folder_tree" model="ir.ui.view">
            <field name="name">joplin.folder.tree</field>
            <field name="model">joplin.folder</field>
            <field name="arch" type="xml">
                <list string="Folders">
                    <field name="name"/>
                    <field name="parent_id" optional="show"/>
                    <field name="note_count"/>
                    <field name="user_id" optional="hide"/>
                    <field name="updated_time"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_joplin_folder_form" model="ir.ui.view">
            <field name="name">joplin.folder.form</field>
            <field name="model">joplin.folder</field>
            <field name="arch" type="xml">
                <form string="Folder">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Folder name..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="parent_id"/>
                                <field name="user_id"/>
                            </group>
                            <group>
                                <field name="note_count"/>
                                <field name="icon"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="notes" string="Notes">
                                <field name="note_ids">
                                    <list>
                                        <field name="title"/>
                                        <field name="tag_ids" widget="many2many_tags"/>
                                        <field name="updated_time"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_joplin_folder" model="ir.actions.act_window">
            <field name="name">Folders</field>
            <field name="res_model">joplin.folder</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_joplin_folder_search"/>
        </record>

    </data>
</odoo>
