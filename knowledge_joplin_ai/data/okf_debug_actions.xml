<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The OKF entry in the debug menu for knowledge_joplin_ai
        (okf-mixin F5.10).

        The action itself is generic and lives in ai_agent_core
        (`ai.okf.mixin.action_open_okf`); only the BINDING is declared
        here. `binding_model_id` must point at a concrete model, and the
        model lives in this bridge module — hence four lines of XML, no
        Python.

        `base.group_no_one` = debug mode is on (the same mechanism as
        *Metadata* and *Data*).
    -->
    <record id="action_okf_joplin_note" model="ir.actions.server">
        <field name="name">OKF</field>
        <field name="model_id" ref="knowledge_joplin.model_joplin_note"/>
        <field name="binding_model_id" ref="knowledge_joplin.model_joplin_note"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('base.group_no_one'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['ai.okf.mixin'].action_open_okf()</field>
    </record>
</odoo>
