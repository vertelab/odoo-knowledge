<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_users_form_inherit_joplin" model="ir.ui.view">
            <field name="name">res.users.form.inherit.joplin</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page name="joplin" string="Joplin">
                        <group name="joplin_connection_group">
                            <group>
                                <field name="joplin_api_url" readonly="1"/>
                            </group>
                            <group>
                                <field name="joplin_instruction_html" readonly="1" nolabel="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
